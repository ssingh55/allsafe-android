<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="@color/black">

    <!-- Row 1: Numbers 1-9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/key_1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="1"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="2"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="3"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="4"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="5"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_6"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="6"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_7"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="7"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_8"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="8"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_9"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="9"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />
    </LinearLayout>

    <!-- Row 2: Letters A-I -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/key_a"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="A"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_b"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="B"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_c"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="C"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_d"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="D"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_e"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="E"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_f"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="F"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_g"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="G"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_h"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="H"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_i"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="I"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />
    </LinearLayout>

    <!-- Row 3: Letters J-R -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/key_j"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="J"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_k"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="K"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_l"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="L"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_m"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="M"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_n"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="N"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_o"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="O"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_p"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="P"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_q"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="Q"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_r"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="R"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />
    </LinearLayout>

    <!-- Row 4: Letters S-Z and 0 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/key_s"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="S"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_t"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="T"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_u"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="U"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_v"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="V"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_w"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="W"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_x"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="X"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_y"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="Y"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_z"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="Z"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_0"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="0"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />
    </LinearLayout>

    <!-- Row 5: Special characters and control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_space"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="3"
            android:layout_marginEnd="2dp"
            android:text="SPACE"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_backspace"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:layout_marginEnd="2dp"
            android:text="BKSP"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_dot"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="."
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />

        <Button
            android:id="@+id/key_at"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@"
            android:textColor="@color/white"
            android:background="@color/secondaryColor" />
    </LinearLayout>

</LinearLayout>
